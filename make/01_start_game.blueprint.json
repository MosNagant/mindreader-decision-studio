      "mapper": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "method": "post",
        "timeout": "40",
        "contentType": "json",
        "inputMethod": "jsonString",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "jsonStringBodyContent": "{\n  \"model\": \"openrouter/free\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are MindReader, an AI behavioral choice game assistant. Generate one realistic behavioral decision scenario for the user. The scenario should be based on everyday life, workplace interactions, interpersonal relationships, or personal decision-making. It should reveal meaningful behavioral tendencies such as communication, responsibility, risk preference, emotional control, cooperation, or decision-making style. Return exactly one valid JSON object containing scenario_id, question, options, and difficulty. scenario_id must be a short unique-looking identifier. question must describe a clear and realistic situation and end with a decision question. options MUST be an array of exactly four distinct and plausible strings, labeled A, B, C, and D. Each option should represent a meaningfully different response strategy, without an obviously correct answer. difficulty MUST be an integer from 1 to 5. Ensure the question and all options are logically consistent. Return JSON only, without Markdown code fences or explanations.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate one new behavioral decision scenario. Prefer realistic situations with enough context for the user to make a meaningful choice. Ensure all four options are reasonable but reflect different behavioral tendencies.\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 4096,\n  \"reasoning\": {\n    \"effort\": \"low\"\n  }\n}",
        "requestCompressedContent": true
      },
